{
  "name": "dsh-skill-curator",
  "version": "0.1.0",
  "description": "RU-first skill studio for DeepSeek Harness: browse, inspect, validate and curate agent skills (SKILL.md plus references) across DSH, project and external agent roots.",
  "type": "module",
  "license": "MIT",
  "author": "Rinat Fathutdinov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RinatITP/dsh-plugins.git",
    "directory": "packages/dsh-skill-curator"
  },
  "bugs": {
    "url": "https://github.com/RinatITP/dsh-plugins/issues"
  },
  "homepage": "https://github.com/RinatITP/dsh-plugins/tree/main/packages/dsh-skill-curator#readme",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "skill",
    "skills",
    "skill-manager",
    "agent-skills"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  }
}
